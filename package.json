{
  "name": "fantasy-map-builder-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "test:entities": "npm --prefix client run test:entities",
    "test:entities:offline": "npm --prefix client run test:entities:offline",
    "test:entities:models": "npm --prefix client run test:entities:models",
    "test:entities:all": "npm --prefix client run test:entities:all",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "puppeteer": "^25.8.0"
  }
}
