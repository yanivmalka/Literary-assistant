PORT=3001

# ============================================
# Supabase (required for document storage and database)
# ============================================
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# AI Providers — All OPTIONAL
# The system works without any paid AI service.
# ============================================

# Embedding Provider (default: xenova-local — runs locally, zero cost)
# Options: xenova-local, huggingface
EMBEDDING_PROVIDER=xenova-local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# For better Hebrew support, consider: Xenova/multilingual-e5-small or Xenova/paraphrase-multilingual-MiniLM-L12-v2

# Completion Provider (optional — needed for entity extraction and Q&A)
# Options: huggingface (free tier)
# Leave empty to disable AI-dependent features (entity extraction, Q&A)
COMPLETION_PROVIDER=huggingface
COMPLETION_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# HuggingFace API Key (free tier — get from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Future paid providers (uncomment when needed):
# COMPLETION_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# COMPLETION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================
# Log maintenance (server-only)
# Generate a long random value and never expose it to the client.
# ============================================
LOG_MAINTENANCE_TOKEN=replace-with-a-long-random-maintenance-token
